# Copy to .env and adjust. Never commit .env.

ENVIRONMENT=development

# SQLite for local development; PostgreSQL for docker-compose / production.
# DATABASE_URL=postgresql+psycopg://netsentinel:change-me@localhost:5432/netsentinel
DATABASE_URL=sqlite:///./netsentinel.db
# docker-compose only:
POSTGRES_PASSWORD=

# REQUIRED in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# In development an ephemeral secret is generated if this is empty (tokens reset on restart).
JWT_SECRET=
ACCESS_TOKEN_MINUTES=60

# Development seed accounts (admin / analyst / viewer). Leave a password empty to skip that user.
# Use your own values; these are only read on first start.
SEED_ADMIN_PASSWORD=
SEED_ANALYST_PASSWORD=
SEED_VIEWER_PASSWORD=

# Show a "continue as guest" button on the login page (issues a read-only VIEWER session).
GUEST_ACCESS=false

CORS_ORIGINS=http://localhost:3000

# simulation = synthetic telemetry (clearly labelled in the UI) | idle = no source attached
TELEMETRY_MODE=simulation
SIMULATION_SEED=1337
SIMULATION_EVENTS_PER_SECOND=4
EVENT_RETENTION=20000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
