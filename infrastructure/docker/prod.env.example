# Copy to .env.prod (gitignored) and fill in every value. Never commit it.

# Public hostname pointing at the server (A/AAAA record). Use "localhost" to test locally.
DOMAIN=

# python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# The only account created on a public, read-only instance. Share this one with visitors.
SEED_VIEWER_PASSWORD=

# Leave empty to keep the instance read-only. Setting either enables write features
# (attack demo, PCAP upload, notes) for that account, including uploads from the internet.
SEED_ADMIN_PASSWORD=
SEED_ANALYST_PASSWORD=
